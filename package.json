{
  "name": "fitsarap",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && wrangler dev --local",
    "deploy": "vite build && wrangler deploy",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:local": "wrangler d1 migrations apply fitsarap-db --local",
    "db:remote": "wrangler d1 migrations apply fitsarap-db --remote",
    "data": "node scripts/build-recipes.mjs",
    "data:seed": "node scripts/build-recipes.mjs --file scripts/seed-rows.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
